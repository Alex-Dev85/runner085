rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê e escreve o próprio perfil.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Qualquer outra coleção fica bloqueada até ter regras próprias.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
